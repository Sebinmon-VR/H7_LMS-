# Project Configuration
PROJECT_NAME="LMS Backend API"
API_V1_STR="/api/v1"
DEBUG=True

# CORS — browser origins allowed to call this API.
# Comma-separated and scheme-qualified, no trailing slash. Set this to the Static Web App's
# hostname (and any custom domain) in the App Service application settings.
# Note: leave App Service -> API -> CORS EMPTY in the Azure portal. When it has any entry,
# Azure answers preflights itself and this configuration never runs.
CORS_ALLOW_ORIGINS="https://your-app.azurestaticapps.net"
# Fallback pattern (re.fullmatch) covering SWA preview environments and local dev servers.
# Clear it to accept only the exact origins listed above.
CORS_ALLOW_ORIGIN_REGEX="https://([a-z0-9-]+\.)*azurestaticapps\.net|http://localhost(:\d+)?|http://127\.0\.0\.1(:\d+)?"

# Database Provider Configuration (Primary: Firebase Cloud Firestore)
DATABASE_PROVIDER="FIREBASE_FIRESTORE"
DATABASE_URL="sqlite:///./lms.db"

# Security & JWT Tokens (legacy tokens only; Firebase Auth is the primary provider)
SECRET_KEY="YOUR_SUPER_SECRET_JWT_KEY_CHANGE_THIS_IN_PRODUCTION"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Authentication Provider
# Clients sign in with the Firebase SDK and send the ID token as: Authorization: Bearer <idToken>
AUTH_PROVIDER="FIREBASE"
# Keep True while migrating so legacy backend-issued JWTs still work. Set False after cutover.
ALLOW_LEGACY_JWT_LOGIN=True
# Firebase Web API key (Project settings -> General -> Web API Key).
# Only needed for the dev-only /auth/login helper and the Swagger auth modal.
FIREBASE_WEB_API_KEY=""

# Bootstrap administrator.
# There is no public registration endpoint, so this single account is created at startup if
# absent, giving you a way into an empty system. Existing accounts are never overwritten.
# Change the password before deploying anywhere real.
BOOTSTRAP_ADMIN_EMAIL="admin@yourschool.com"
BOOTSTRAP_ADMIN_PASSWORD="change-me-before-deploying"
BOOTSTRAP_ADMIN_NAME="System Administrator"
# Sample class/subject records for local experimentation. Leave False to start empty.
SEED_DEMO_DATA=False

# Google Cloud & Firebase Configuration
GCP_PROJECT_ID="your-gcp-project-id"
GCP_BUCKET_NAME="your-storage-bucket-name"
GOOGLE_APPLICATION_CREDENTIALS="./service_account.json"
FIREBASE_CREDENTIALS_PATH="./firebase_credentials.json"
USE_FIREBASE_DB=True
USE_LOCAL_STORAGE=False
LOCAL_STORAGE_DIR="./uploads"

# Google Workspace Integration (Google Meet via the Calendar API)
# Prerequisites, in order - GET /api/v1/admin/integrations tells you which one is missing
# and prints the numeric Client ID you need for step 2:
#   1. Enable the Google Calendar API (and the Drive API) on the GCP project.
#   2. Admin console -> Security -> Access and data control -> API controls -> Manage
#      Domain Wide Delegation. Add the service account's *numeric Client ID* (not its
#      email) with this one scope - it is all Meet needs:
#        https://www.googleapis.com/auth/calendar.events
#   3. Point GOOGLE_IMPERSONATION_FALLBACK at a real user in the domain.
GOOGLE_WORKSPACE_DOMAIN="yourschool.com"
# Workspace user impersonated when a teacher's email is outside the domain. Must be real.
GOOGLE_IMPERSONATION_FALLBACK="admin@yourschool.com"
# Auto-create Google Calendar events with Meet links when teachers schedule a session
ENABLE_GOOGLE_MEET=True
GOOGLE_CALENDAR_ID="primary"
# IANA zone stamped on every event. Calendar rejects a naive time with no zone, which is the
# most common reason Meet link generation silently produces nothing.
GOOGLE_CALENDAR_TIMEZONE="Asia/Dubai"
# Turn off on a project without Google Workspace: the service account then writes to a
# calendar shared directly with it, and GOOGLE_CALENDAR_ID must name that calendar
# ("primary" does not exist for a service account).
GOOGLE_CALENDAR_IMPERSONATION=True
# Invite enrolled students as Calendar guests. Turning this off still yields a Meet link.
GOOGLE_MEET_INVITE_ATTENDEES=True
# Comma-separated Calendar scopes. Leave blank to probe narrowest-first and settle on
# whatever delegation actually granted. Google rejects the entire token exchange with
# `unauthorized_client` if any requested scope is unauthorized, so requesting extra scopes
# "just in case" breaks an otherwise working grant.
GOOGLE_CALENDAR_SCOPES=""

# Storage Backend: GCS (default) | DRIVE | LOCAL
# GCS is cheaper and faster for plain file serving. Use DRIVE when teachers need in-place
# preview and collaborative editing of documents.
# NOTE: USE_LOCAL_STORAGE=True above forces LOCAL only when STORAGE_PROVIDER is left unset.
STORAGE_PROVIDER="GCS"
# Set one of the two when STORAGE_PROVIDER=DRIVE. A full drive.google.com URL is accepted
# and unwrapped, so pasting the address bar works.
# Shared Drive (recommended): create one, add the service account as Content manager, copy
# the ID from drive.google.com/drive/folders/<ID>. No impersonation needed - files are owned
# by the organization, so the service account's lack of personal storage quota is irrelevant.
GOOGLE_DRIVE_SHARED_DRIVE_ID=""
# Ordinary folder: only works with GOOGLE_DRIVE_IMPERSONATION=True, because a service
# account cannot own files outside a Shared Drive.
GOOGLE_DRIVE_FOLDER_ID=""
GOOGLE_DRIVE_ROOT_FOLDER_NAME="H7 LMS Materials"
# Act as GOOGLE_IMPERSONATION_FALLBACK for Drive calls. Leave False with a Shared Drive.
GOOGLE_DRIVE_IMPERSONATION=False
# Grant "anyone with the link can view" on uploads so students can open them without a
# Workspace account. Set False for domain-only distribution.
GOOGLE_DRIVE_LINK_SHARING=True
# False: an upload that cannot reach the cloud provider still saves locally and returns a
# warning. True: it returns 502 instead, so a broken integration cannot go unnoticed.
STORAGE_STRICT=False

# Timetable & Class Reminders
# Timetable periods are stored as local wall-clock times ("assembly is at 08:00") and
# resolved in this zone. Falls back to GOOGLE_CALENDAR_TIMEZONE when blank.
SCHOOL_TIMEZONE="Asia/Dubai"
ENABLE_CLASS_REMINDERS=True
# Minutes before a period to email students (and teachers). Comma-separated for several
# nudges, e.g. "60,15" for a day-planning reminder and a get-to-class one.
CLASS_REMINDER_MINUTES_BEFORE="15"
# How often the background sweep looks for periods entering a reminder window. Keep this
# below the smallest offset above, or a window can be stepped over entirely.
REMINDER_SCAN_INTERVAL_SECONDS=120
# Also remind the teacher taking the period, not only the enrolled students.
REMIND_TEACHERS=True
# A reminder that came due longer ago than this is dropped, so a server that was down all
# morning does not flood everyone about classes that already finished on restart.
REMINDER_MAX_LATENESS_MINUTES=10

# Credential Provisioning
# Admins create a teacher/student by name; the login email is generated as
# firstname.lastname@USER_EMAIL_DOMAIN (a numeric suffix is added on collision) and the
# password is generated by POST /api/v1/admin/users/{id}/generate-credentials.
# Leave blank to fall back to GOOGLE_WORKSPACE_DOMAIN.
USER_EMAIL_DOMAIN="yourschool.com"
GENERATED_PASSWORD_LENGTH=12
# Included as the sign-in link in the credentials email. Leave blank to omit the link.
LMS_LOGIN_URL="https://lms.yourschool.com/login"

# Outbound Email (Gmail / Google Workspace SMTP)
# SMTP_PASSWORD must be a 16-character Google App Password, NOT the account password.
# Generate one at https://myaccount.google.com/apppasswords (requires 2-Step Verification).
ENABLE_EMAIL_NOTIFICATIONS=True
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USE_TLS=True
SMTP_USER="noreply@yourschool.com"
SMTP_PASSWORD=""
# Defaults to SMTP_USER / PROJECT_NAME when blank.
SMTP_FROM=""
SMTP_FROM_NAME="H7 LMS"
SMTP_TIMEOUT_SECONDS=20
