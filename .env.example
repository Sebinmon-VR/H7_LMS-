# Project Configuration
PROJECT_NAME="LMS Backend API"
API_V1_STR="/api/v1"
DEBUG=True

# CORS — browser origins allowed to call this API.
# Comma-separated and scheme-qualified, no trailing slash. Set this to the Static Web App's
# hostname (and any custom domain) in the App Service application settings.
# Note: leave App Service -> API -> CORS EMPTY in the Azure portal. When it has any entry,
# Azure answers preflights itself and this configuration never runs.
CORS_ALLOW_ORIGINS="https://your-app.azurestaticapps.net"
# Fallback pattern (re.fullmatch) covering SWA preview environments and local dev servers.
# Clear it to accept only the exact origins listed above.
CORS_ALLOW_ORIGIN_REGEX="https://([a-z0-9-]+\.)*azurestaticapps\.net|http://localhost(:\d+)?|http://127\.0\.0\.1(:\d+)?"

# Database: Azure SQL. Every collection is a JSON-document table inside DB_SCHEMA, on a server
# the app may share with others - nothing outside that schema is touched.
DATABASE_BACKEND=azuresql
DB_SERVER=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SCHEMA=h7lms
DB_DRIVER="ODBC Driver 18 for SQL Server"

# Sign-in (app/core/identity.py). Passwords are hashed in the `user_credentials` table and
# sessions are tokens this backend signs with SECRET_KEY. Changing SECRET_KEY signs everybody
# out. Use a long random value in production:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="YOUR_SUPER_SECRET_JWT_KEY_CHANGE_THIS_IN_PRODUCTION"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
PASSWORD_MIN_LENGTH=8
PASSWORD_RESET_TOKEN_MINUTES=60
LOGIN_MAX_FAILURES=10
LOGIN_LOCKOUT_MINUTES=15
# The frontend's origin, used to build password-reset and class links in emails.
LMS_APP_URL="https://lms.yourschool.com"
# Moving off Firebase Auth: while set, an account with no password stored here yet is checked
# against Firebase once and moved over. Leave blank once scripts/import_firebase_passwords.py
# has been run (it was, on 2026-09-30).
FIREBASE_WEB_API_KEY=""

# Bootstrap administrator.
# There is no public registration endpoint, so this single account is created at startup if
# absent, giving you a way into an empty system. Existing accounts are never overwritten.
# Change the password before deploying anywhere real.
BOOTSTRAP_ADMIN_EMAIL="admin@yourschool.com"
BOOTSTRAP_ADMIN_PASSWORD="change-me-before-deploying"
BOOTSTRAP_ADMIN_NAME="System Administrator"
# Sample class/subject records for local experimentation. Leave False to start empty.
SEED_DEMO_DATA=False

USE_LOCAL_STORAGE=False
LOCAL_STORAGE_DIR="./uploads"

# File storage: Azure Blob Storage. Files are private blobs; the API answers /files/<blob> with
# a read link that expires after AZURE_BLOB_LINK_MINUTES.
STORAGE_PROVIDER="AZURE_BLOB"
# Storage account -> Security + networking -> Access keys -> Connection string.
AZURE_STORAGE_CONNECTION_STRING=""
AZURE_STORAGE_CONTAINER="lms-files"
AZURE_BLOB_LINK_MINUTES=60
# False: an upload that cannot reach Blob storage still saves locally and returns a warning.
# True: it returns 502 instead, so a broken integration cannot go unnoticed.
STORAGE_STRICT=False

# Live classes: Azure Communication Services. Classes are joined inside the LMS (/call/...);
# nobody needs a Microsoft or Google account.
# Communication resource -> Settings -> Keys -> Connection string.
ACS_CONNECTION_STRING=""
ENABLE_ACS_CALLING=True
ACS_ROOM_VALIDITY_DAYS=180
ACS_ROOM_RENEW_DAYS=14
ACS_TOKEN_HOURS=6

# Class recording (ACS Call Recording). A session set to record starts when its teacher joins
# and stops when they leave. Finished files arrive through Event Grid: subscribe the
# Communication resource's Microsoft.Communication.RecordingFileStatusUpdated events to
#   https://<api-host>/api/v1/calls/events?key=<ACS_EVENTS_KEY>
ENABLE_AUTO_RECORDING=True
ACS_EVENTS_KEY=""
RECORDING_FOLDER_NAME="recordings"
RECORDING_MAX_AGE_HOURS=48
RECORDING_MAX_MINUTES=180
RECORDING_SCAN_INTERVAL_SECONDS=300

# Timetable & Class Reminders
# Timetable periods are stored as local wall-clock times ("assembly is at 08:00") and
# resolved in the school's zone. That zone is set by an admin under School Settings; this
# is only the fallback for when School Settings has none.
SCHOOL_TIMEZONE="Asia/Kolkata"
ENABLE_CLASS_REMINDERS=True
# Minutes before a period to email students (and teachers). Comma-separated for several
# nudges, e.g. "60,15" for a day-planning reminder and a get-to-class one.
CLASS_REMINDER_MINUTES_BEFORE="15"
# How often the background sweep looks for periods entering a reminder window. Keep this
# below the smallest offset above, or a window can be stepped over entirely.
REMINDER_SCAN_INTERVAL_SECONDS=300
# Also remind the teacher taking the period, not only the enrolled students.
REMIND_TEACHERS=True
# A reminder that came due longer ago than this is dropped, so a server that was down all
# morning does not flood everyone about classes that already finished on restart.
REMINDER_MAX_LATENESS_MINUTES=10

# Online Tuition Module
# A separate one-to-one product sharing this deployment's login, users and infrastructure.
# Access is per user: a teacher or student needs "TUITION" in the `programs` list on their
# profile (set at creation, or with PUT /api/v1/admin/tuition/users/{id}/programs) before any
# tuition endpoint will answer them. Admins reach both products unconditionally.
#
# IMPORTANT: everything below is a *deployment default*. The values an administrator actually
# operates on are stored in the database and edited from GET/PUT /api/v1/admin/tuition/settings/
# {LMS|TUITION} - so class length, reminder lead times and the timezone can be changed without
# a redeploy. These are what applies until somebody changes them there.
ENABLE_TUITION_MODULE=True
# The zone tuition class times are written and read in, and what every user sees until their
# own zone is known. Its own setting rather than inheriting SCHOOL_TIMEZONE: the tuition
# programme runs on Indian time whatever zone the school itself keeps.
#
# A user outside this zone does NOT need configuring. The frontend sends the browser's own
# zone as an `X-Timezone` header (Intl.DateTimeFormat().resolvedOptions().timeZone); it is
# saved on their profile and every time they are shown - on screen and in reminder emails -
# is converted to it. A zone set explicitly via PUT /api/v1/tuition/me/timezone overrides
# detection and survives travel.
TUITION_TIMEZONE="Asia/Kolkata"
# Default length of one one-to-one class, in minutes.
TUITION_DEFAULT_SESSION_MINUTES=60
ENABLE_TUITION_REMINDERS=True
# Minutes before a class to remind student and teacher. Comma-separated for several nudges.
# Kept separate from CLASS_REMINDER_MINUTES_BEFORE: a one-to-one class wants a short, sharp
# nudge where a school timetable wants a morning summary.
TUITION_REMINDER_MINUTES_BEFORE="10"
# WHO STARTS THE CLASS.
# False (default) - the teacher presses start, and that moment is when the class begins. A
#                   student cannot be marked late for a class nobody has started: somebody
#                   waiting since 17:00 for a class opened at 17:12 is on time, and only the
#                   minutes after 17:12 count against them.
# True            - the class opens on its timetabled slot whether or not the teacher has
#                   arrived, and student lateness is measured from the timetable.
# Both join times are recorded either way, and a late teacher still earns the student extra
# time in either mode. Admin-editable at runtime as `auto_start_class`.
TUITION_AUTO_START_CLASS=False

# THE LATE-TEACHER RULE. When a teacher joins late the class runs on so the student still
# gets a full lesson - but never more than this many minutes past the scheduled end, or one
# late teacher pushes the student's next class off the evening. (A late *student* never
# extends anything; the teacher may finish on time.)
TUITION_MAX_TEACHER_LATE_EXTENSION_MINUTES=30
# A teacher who has not joined this long after the start is recorded as a no-show, which
# makes the class non-billable. Distinct from the cap above: this decides whether the class
# happened at all, that one decides how long it may run.
TUITION_TEACHER_NO_SHOW_MINUTES=15
# Minutes after the start beyond which a student's arrival is suggested as LATE rather than
# PRESENT. A suggestion only - the teacher's mark always wins.
TUITION_STUDENT_LATE_GRACE_MINUTES=5
# Minimum gap between two consecutive classes for the same person, so a teacher is not
# scheduled to finish one class and start another in the same minute. 0 allows back-to-back.
TUITION_MIN_GAP_MINUTES=0
# How far ahead concrete classes are generated from the recurring weekly slots.
TUITION_SESSION_HORIZON_DAYS=30
# Students may upload to the shared library; anything wider than PRIVATE waits for a teacher
# to approve it. Set False to publish student uploads immediately.
TUITION_STUDENT_UPLOADS_NEED_APPROVAL=True
TUITION_CURRENCY="INR"
# Identifiers issued to tuition accounts created without one, as PREFIX-YEAR-0001
# (e.g. TUI-2026-0001). Every tuition student carries a unique admission number; leaving an
# administrator to invent one per student is how blanks and duplicates get into the data.
TUITION_ADMISSION_PREFIX="TUI"
TUITION_EMPLOYEE_PREFIX="TUT"

# Credential Provisioning
# Admins create a teacher/student by name; the login email is generated as
# firstname.lastname@USER_EMAIL_DOMAIN (a numeric suffix is added on collision) and the
# password is generated by POST /api/v1/admin/users/{id}/generate-credentials.
USER_EMAIL_DOMAIN="yourschool.com"
GENERATED_PASSWORD_LENGTH=12
# Included as the sign-in link in the credentials email. Leave blank to omit the link.
LMS_LOGIN_URL="https://lms.yourschool.com/login"

# Outbound Email
# ACS (default): Azure Communication Services Email. Connect an email domain to the
# Communication resource (the free Azure-managed domain works at once; a custom domain needs
# DNS records) and set ACS_EMAIL_SENDER to its MailFrom address.
# SMTP: any relay, for a school that already has one.
ENABLE_EMAIL_NOTIFICATIONS=True
EMAIL_PROVIDER=""
ACS_EMAIL_SENDER="DoNotReply@<guid>.azurecomm.net"
# Blank uses ACS_CONNECTION_STRING.
ACS_EMAIL_CONNECTION_STRING=""
SMTP_HOST=""
SMTP_PORT=587
SMTP_USE_TLS=True
SMTP_USER=""
SMTP_PASSWORD=""
# Defaults to SMTP_USER / PROJECT_NAME when blank.
SMTP_FROM=""
SMTP_FROM_NAME="H7 LMS"
SMTP_TIMEOUT_SECONDS=20
